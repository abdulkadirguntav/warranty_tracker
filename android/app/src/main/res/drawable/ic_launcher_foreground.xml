<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground — exact match of lib/presentation/widgets/app_logo.dart
  Drawn at the full adaptive-icon safe zone (108dp viewport; visible 72dp centre).
  Brand colours mirror AppTheme.brandTeal (#14B8A6), brandBlue (#3B82F6), brandBlueDeep (#2563EB).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield silhouette filled with a diagonal teal→blue→blueDeep gradient.
         Coordinates mirror app_logo.dart with inset = 108*0.10 = 10.8 (≈11)
         and topRadius = 108*0.16 ≈ 17. The shield is moved to sit visually in
         the centre of the adaptive 108dp canvas (the inner 80dp safe zone). -->
    <path
        android:pathData="M 55,28
            L 97,28
            A 17,17 0 0 1 114,45
            L 114,72
            C 114,86 103,98 78,108
            C 64,114 44,114 30,108
            C 5,98 -6,86 -6,72
            L -6,45
            A 17,17 0 0 1 11,28
            Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"   android:startY="28"
                android:endX="108"   android:endY="108"
                android:startColor="#FF14B8A6"
                android:centerColor="#FF3B82F6"
                android:centerX="60" android:centerY="68"
                android:endColor="#FF2563EB" />
        </aapt:attr>
    </path>

    <!-- Inner rim highlight — thin white stroke along the shield edge. -->
    <path
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="2.7"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 55,28
            L 97,28
            A 17,17 0 0 1 114,45
            L 114,72
            C 114,86 103,98 78,108
            C 64,114 44,114 30,108
            C 5,98 -6,86 -6,72
            L -6,45
            A 17,17 0 0 1 11,28
            Z" />

    <!-- White verification tick, mirrors app_logo.dart polyline:
         moveTo(0.32,0.52) -> lineTo(0.45,0.65) -> lineTo(0.70,0.38)
         Mapped into 108dp canvas with shield anchored at (-6,28). -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 28.6,84.2
            L 42.5,98.2
            L 69.6,68.8" />
</vector>
