# Release signing configuration template.
#
# 1) Generate a keystore (keep it secret, never commit it):
#    keytool -genkey -v -keystore android/app/upload-keystore.jks \
#      -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2) Copy this file to "key.properties" (same folder) and fill in the values.
#
# 3) Your keystore file and key.properties are already gitignored.
#
# NOTE: The store/alias passwords are required even when the keystore is
# generated with the same password for both.

storePassword=<your-store-password>
keyPassword=<your-key-password>
keyAlias=upload
storeFile=upload-keystore.jks
